{
  "name": "notelah",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, offline home for your daily work.",
  "author": "NoteLah",
  "main": "desktop-dist/electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build:web": "next build --webpack",
    "build": "npm run build:web && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable",
    "test": "tsx --test tests/*.test.ts",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "sql.js": "1.14.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "local.notelah.desktop",
    "productName": "NoteLah",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "desktop-dist/**/*",
      "package.json",
      "assets/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "NoteLah-${version}.exe"
    }
  },
  "license": "UNLICENSED"
}
